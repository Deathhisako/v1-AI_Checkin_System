%% 系统四层架构图 (Mermaid, GitHub 原生渲染)
flowchart TB
    subgraph APP["应用层 App Layer"]
        direction LR
        A1[用户配置] --- A2[任务编排 Scheduler]
        A2 --- A3[结果通知 Notifier]
    end
    subgraph DEC["决策层 Decision Layer"]
        direction LR
        D1[LLM 语义理解] --- D2[页面解析 Parser]
        D2 --- D3[异常诊断 Diagnostician]
    end
    subgraph PER["感知层 Perception Layer"]
        direction LR
        P1[OCR PaddleOCR] --- P2[视觉大模型 Vision]
        P2 --- P3[验证码识别 CaptchaSolver]
    end
    subgraph EXE["执行层 Execution Layer"]
        direction LR
        E1[请求构造 Requester] --- E2[浏览器自动化 Browser]
        E2 --- E3[Cookie 管理 CookieManager]
        E3 --- E4[加密适配 CryptoAdapter]
    end
    subgraph CORE["核心: 自愈引擎 SelfHealEngine"]
        direction LR
        C1[监控 Monitor] --- C2[诊断 Diagnose]
        C2 --- C3[决策 Decide]
        C3 --- C4[自愈 Heal]
    end

    APP --> DEC
    DEC --> PER
    PER --> EXE
    EXE --> CORE
    CORE -.反馈闭环.-> APP

    style APP fill:#e3f2fd,stroke:#1565c0
    style DEC fill:#e8f5e9,stroke:#2e7d32
    style PER fill:#fff3e0,stroke:#ef6c00
    style EXE fill:#f3e5f5,stroke:#6a1b9a
    style CORE fill:#fce4ec,stroke:#c62828
